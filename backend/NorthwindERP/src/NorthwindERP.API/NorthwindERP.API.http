@host = http://localhost:5080
@token = PEGA_AQUI_EL_TOKEN

### Login: copia el token de la respuesta en @token
POST {{host}}/api/auth/login
Content-Type: application/json

{ "username": "admin", "password": "TU_PASSWORD" }

############################ CLIENTES ############################

### Lista de clientes
GET {{host}}/api/customers
Authorization: Bearer {{token}}

### Un cliente
GET {{host}}/api/customers/1
Authorization: Bearer {{token}}

### Actualizar la dirección de un cliente
PUT {{host}}/api/customers/1
Authorization: Bearer {{token}}
Content-Type: application/json

{ "address": "Obere Str. 58", "city": "Berlin" }

### Cambiar el nombre y el contacto (lo demás queda igual)
PUT {{host}}/api/customers/1
Authorization: Bearer {{token}}
Content-Type: application/json

{ "customerName": "Alfreds Futterkiste GmbH", "contactName": "Maria Anders" }

### Body vacío -> 400
PUT {{host}}/api/customers/1
Authorization: Bearer {{token}}
Content-Type: application/json

{}

### Cliente inexistente -> 404
GET {{host}}/api/customers/9999
Authorization: Bearer {{token}}

### Registrar un cliente sin pedido -> 201 + Location
POST {{host}}/api/customers
Authorization: Bearer {{token}}
Content-Type: application/json

{ "customerName": "Minimarket San Isidro", "contactName": "Lucía Paredes", "address": "Av. Javier Prado 450", "city": "Lima", "postalCode": "15036", "country": "Peru" }

### Sin nombre -> 400
POST {{host}}/api/customers
Authorization: Bearer {{token}}
Content-Type: application/json

{ "city": "Lima" }

############################ PEDIDOS ############################

### Crear pedido con cliente nuevo
POST {{host}}/api/orders/with-customer
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "newCustomer": { "customerName": "Bodega Miraflores SAC", "city": "Lima", "country": "Peru" },
  "warehouseId": 1,
  "shipperId": 2,
  "items": [ { "productId": 11, "quantity": 2 }, { "productId": 42, "quantity": 1 } ]
}

### Pedido sin stock -> 409 NW409 (no se guarda nada)
POST {{host}}/api/orders/with-customer
Authorization: Bearer {{token}}
Content-Type: application/json

{ "customerId": 20, "warehouseId": 1, "items": [ { "productId": 11, "quantity": 9999 } ] }

### customerId y newCustomer a la vez -> 400
POST {{host}}/api/orders/with-customer
Authorization: Bearer {{token}}
Content-Type: application/json

{ "customerId": 20, "newCustomer": { "customerName": "X" }, "warehouseId": 1, "items": [ { "productId": 11, "quantity": 1 } ] }

### Detalle de un pedido
GET {{host}}/api/orders/10248
Authorization: Bearer {{token}}

### Pedidos de un empleado en 1997
GET {{host}}/api/orders?employeeId=4&from=1997-01-01&to=1997-12-31
Authorization: Bearer {{token}}

### Historial de un cliente
GET {{host}}/api/orders/customer/20
Authorization: Bearer {{token}}

### Eliminar pedido (solo Admin): cambia el id por el que creaste
DELETE {{host}}/api/orders/10444
Authorization: Bearer {{token}}

############################ LOGÍSTICA ############################

### Empleados (9 en Northwind)
GET {{host}}/api/employees
Authorization: Bearer {{token}}

### Sin token -> 401
GET {{host}}/api/employees

### Transportistas (3)
GET {{host}}/api/shippers
Authorization: Bearer {{token}}

### Proveedores (29)
GET {{host}}/api/suppliers
Authorization: Bearer {{token}}

############################ INVENTARIO ############################

### Catálogo completo (77 productos)
GET {{host}}/api/products
Authorization: Bearer {{token}}

### Buscar por nombre dentro de una categoría
GET {{host}}/api/products?search=cha&categoryId=1
Authorization: Bearer {{token}}

### Categorías (8)
GET {{host}}/api/categories
Authorization: Bearer {{token}}

### Un producto
GET {{host}}/api/products/11
Authorization: Bearer {{token}}

### Producto inexistente -> 404
GET {{host}}/api/products/9999
Authorization: Bearer {{token}}

### Registrar un producto -> 201 (queda con stock 0 en los 3 almacenes)
POST {{host}}/api/products
Authorization: Bearer {{token}}
Content-Type: application/json

{ "productName": "Café de Chanchamayo", "categoryId": 1, "supplierId": 1, "unit": "12 bolsas x 500 g", "price": 32.50 }

### Categoría inexistente -> 400
POST {{host}}/api/products
Authorization: Bearer {{token}}
Content-Type: application/json

{ "productName": "Prueba", "categoryId": 999, "price": 10 }

### Sin precio -> 400
POST {{host}}/api/products
Authorization: Bearer {{token}}
Content-Type: application/json

{ "productName": "Prueba" }

### Editar nombre y unidad (cambia el id por el producto que creaste)
PUT {{host}}/api/products/78
Authorization: Bearer {{token}}
Content-Type: application/json

{ "productName": "Café de Chanchamayo orgánico", "unit": "12 bolsas x 1 kg" }

### Cambiar precio: con Admin -> 200, con un usuario Employee -> 403
PUT {{host}}/api/products/78
Authorization: Bearer {{token}}
Content-Type: application/json

{ "price": 35.00 }

### Body vacío -> 400
PUT {{host}}/api/products/78
Authorization: Bearer {{token}}
Content-Type: application/json

{}

### Stock de todos los almacenes (77 productos x 3 almacenes)
GET {{host}}/api/inventory/stock
Authorization: Bearer {{token}}

### Stock de un producto en un almacén (anota la cantidad antes de crear un pedido)
GET {{host}}/api/inventory/stock?warehouseId=1&productId=11
Authorization: Bearer {{token}}

### Solo lo que hay que reponer
GET {{host}}/api/inventory/stock?lowStockOnly=true
Authorization: Bearer {{token}}
